# Copy to .env. Nothing here is required for offline mode.

# offline: deterministic extractive reader, no network.
# openai / gemini: answer with that provider through LangChain.
LLM_MODE=offline
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANSWER_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-5-mini

# Optional LangSmith tracing of the answer workflow and evaluation runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intellidoc

# Retrieval defaults used by the API.
DEFAULT_MODE=hybrid
MIN_SIMILARITY=0.0

POSTGRES_PASSWORD=intellidoc
