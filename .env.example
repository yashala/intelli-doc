# Copy to .env. Nothing here is required for offline mode.

# offline: deterministic extractive reader, no network. gemini: Gemini via LangChain.
LLM_MODE=offline
GOOGLE_API_KEY=
ANSWER_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-pro

# Optional LangSmith tracing of the answer workflow and evaluation runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intellidoc

# Retrieval defaults used by the API.
DEFAULT_MODE=hybrid
MIN_SIMILARITY=0.0

POSTGRES_PASSWORD=intellidoc
